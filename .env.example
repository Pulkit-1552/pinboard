# Copy to .env on the AWS instance after images exist on Docker Hub.
# Locally you can skip this file. Compose uses the defaults below.

# Your Docker Hub username. Images are <username>/pinboard-frontend and so on.
DOCKERHUB_USERNAME=yourdockerhubname

# local  -> laptop builds (docker compose up --build)
# latest -> images published by GitHub Actions
IMAGE_TAG=latest

HTTP_PORT=80

POSTGRES_USER=pinboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pinboard
